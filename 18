-- SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 🔁 AUTO-RESOLVING SESSION FOLDER
local RSFolder

local function resolveRSFolder()
    for _, v in ipairs(ReplicatedStorage:GetChildren()) do
        if v:IsA("Folder") and v:FindFirstChild("Events") and v:FindFirstChild("Functions") then
            return v
        end
    end
end

RSFolder = resolveRSFolder()

ReplicatedStorage.ChildAdded:Connect(function(child)
    if child:IsA("Folder") and child:FindFirstChild("Events") and child:FindFirstChild("Functions") then
        RSFolder = child
        warn("[AzraHub] RS session folder refreshed")
    end
end)

while not RSFolder do
    task.wait()
    RSFolder = resolveRSFolder()
end

