    "+500 rebirths","+100 rebirths","+70 rebirths","+35 rebirths",
    "+15 rebirths","+5 rebirths","+1 rebirth"
}

local selectedRebirthIndex = 1
local AutoRebirth = false

MainSection:NewDropdown("Choose Rebirth!", "Highest ➜ Lowest", rebirthOptions, function(selected)
    for index, name in ipairs(rebirthOptions) do
        if name == selected then
            selectedRebirthIndex = 35 - index
            break
        end
    end
end)

MainSection:NewToggle("Auto Rebirth", "Automatically rebirth", function(state)
    AutoRebirth = state
    if AutoRebirth then
        task.spawn(function()
            local delayTime = 0.5
            while AutoRebirth do
                local success = pcall(function()
                    RSFolder.Functions.Rebirth:InvokeServer(selectedRebirthIndex)
                end)

                if success then
                    delayTime = math.max(0.3, delayTime - 0.05)
                else
                    delayTime = math.min(1.5, delayTime + 0.2)
                end

                task.wait(delayTime)
            end
        end)
    end
end)

