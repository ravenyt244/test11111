    local AutoHatch = false

    MainSection:NewLabel("Auto Hatch")
    MainSection:NewDropdown(
        "Select Egg",
        "Select the egg you want to hatch",
        eggOptions,
        function(option)
            selectedEgg = option
        end
    )

    MainSection:NewDropdown(
        "Select Egg Amount",
        "Select the amount of hatching you want",
        {"1", "3", "8"},
        function(option)
            selectedEggAmount = tonumber(option)
        end
    )

    MainSection:NewToggle("Auto Hatch", "This will make you auto hatch", function(state)
        AutoHatch = state

        if AutoHatch and openEggFunc then
            task.spawn(function()
                while AutoHatch do
                    openEggFunc:InvokeServer(selectedEgg, selectedEggAmount)
                    task.wait(0.5) -- safe delay, adjust if needed
                end
            end)
        elseif AutoHatch and not openEggFunc then
            warn("AzraHub: Cannot start Auto Hatch - OpenEgg function not found.")
        end
    end)

    -- Example Tab: Customize
    local Customize = Window:NewTab("Customize")
    local CustomizeSection = Customize:NewSection("Color Custom")

    -- NewColorPicker
    CustomizeSection:NewColorPicker("SchemeColor", "Change your SchemeColor", Color3.fromRGB(0, 255, 255), function(color)
        Library:ChangeColor("SchemeColor", color)
    end)

    -- Anti-AFK (runs regardless)
    local GC = getconnections or get_signal_cons
    if GC then
        for i, v in pairs(GC(game.Players.LocalPlayer.Idled)) do
            if v["Disable"] then
                v["Disable"](v)
            elseif v["Disconnect"] then
                v["Disconnect"](v)
            end
        end
    else
        local vu = game:GetService("VirtualUser")
        game:GetService("Players").LocalPlayer.Idled:connect(function()
            vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            wait(1)
            vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        end)
    end
