if game.PlaceId == 75992362647444 then
    -- Dynamic folder detection to handle changing UUIDs
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local targetFolder = nil
    
    -- Get all children and filter for Folders
    local folders = {}
    for _, item in ipairs(ReplicatedStorage:GetChildren()) do
        if item:IsA("Folder") then
            table.insert(folders, item)
        end
    end
    
    -- Target the 6th folder specifically (as per your request)
    if #folders >= 6 then
        targetFolder = folders[6]  -- 6th folder (the UUID one)
        print("Detected 6th Folder (UUID): " .. targetFolder.Name)
        setclipboard(targetFolder.Name)  -- Automatically copies to clipboard
        print("UUID copied to clipboard!")
    else
        warn("AzraHub: Not enough folders in ReplicatedStorage (need at least 6). Features may not work.")
        return  -- Exit early
    end
    
    -- Additional checks for Events and Functions
    local eventsFolder = targetFolder:FindFirstChild("Events")
    local functionsFolder = targetFolder:FindFirstChild("Functions")
    if not eventsFolder or not functionsFolder then
        warn("AzraHub: Events or Functions folder missing in " .. targetFolder.Name .. ". Features may not work.")
        return
    end
    
    -- Check for specific items (Tap, Rebirth, OpenEgg)
    local tapEvent = eventsFolder:FindFirstChild("Tap")
    local rebirthFunc = functionsFolder:FindFirstChild("Rebirth")
    local openEggFunc = functionsFolder:FindFirstChild("OpenEgg")
    if not tapEvent then warn("AzraHub: Tap event not found.") end
    if not rebirthFunc then warn("AzraHub: Rebirth function not found.") end
    if not openEggFunc then warn("AzraHub: OpenEgg function not found.") end
    
    -- Proceed with the UI and features
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
    local Window = Library.CreateLib("AzraHub • Tap Simulator", {
        SchemeColor = Color3.fromRGB(83, 91, 255),
        Background = Color3.fromRGB(0, 0, 0),
        Header = Color3.fromRGB(0, 0, 0),
        TextColor = Color3.fromRGB(255, 255, 255),
        ElementColor = Color3.fromRGB(20, 20, 20)
    })

    local Info = Window:NewTab("Info")
    local InfoSection = Info:NewSection("Information")
    InfoSection:NewButton("Copy Discord Link", "Join our discord server!", function()
        setclipboard("https://discord.gg/hnmJ3nsHS9")
    end)

    -- Example Tab: Main
    local Main = Window:NewTab("Main")
    local MainSection = Main:NewSection("Auto Clicker")

    -- Control variable
    local AutoClicker = false

    MainSection:NewToggle("Auto-Clicker [FAST]", "100 Clicks per second", function(state)
        AutoClicker = state

        if AutoClicker and tapEvent then
            task.spawn(function()
                while AutoClicker do
                    tapEvent:FireServer(true, false)
                    task.wait(0.01) -- 100 clicks per second
                end
            end)
        elseif AutoClicker and not tapEvent then
            warn("AzraHub: Cannot start Auto-Clicker - Tap event not found.")
        end
    end)

    local rebirthOptions = {
        "+35t rebirths", -- 34
        "+15t rebirths", -- 33
