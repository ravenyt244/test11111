    -- NewLabel
    MainSection:NewLabel("Auto Rebirth")
    local selectedRebirthIndex = 1

    MainSection:NewDropdown(
        "Choose Rebirth!",
        "Choose your automatic rebirth amount here",
        rebirthOptions,
        function(selected)
            for index, name in ipairs(rebirthOptions) do
                if name == selected then
                    selectedRebirthIndex = 35 - index
                    break
                end
            end
        end
    )

    local AutoRebirth = false

    MainSection:NewToggle("Auto Rebirth", "Automatically rebirth based on selection", function(state)
        AutoRebirth = state

        if AutoRebirth and rebirthFunc then
            task.spawn(function()
                while AutoRebirth do
                    rebirthFunc:InvokeServer(selectedRebirthIndex)
                    task.wait(0.5) -- safe delay (adjust if needed)
                end
            end)
        elseif AutoRebirth and not rebirthFunc then
            warn("AzraHub: Cannot start Auto Rebirth - Rebirth function not found.")
        end
    end)

    local eggOptions = {
        "Acorn",
        "Angelic",
        "Atlantis",
