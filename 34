if game.PlaceId == 75992362647444 then
    local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
    local Window = Library.CreateLib("AzraHub • Tap Simulator", {
        SchemeColor = Color3.fromRGB(83, 91, 255),
        Background = Color3.fromRGB(0, 0, 0),
        Header = Color3.fromRGB(0, 0, 0),
        TextColor = Color3.fromRGB(255, 255, 255),
        ElementColor = Color3.fromRGB(20, 20, 20)
    })

    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    -- Dynamically identify the UUID folder
    local folders = {}
    for _, item in ipairs(ReplicatedStorage:GetChildren()) do
        if item:IsA("Folder") then
            table.insert(folders, item)
        end
    end

    local uuid = nil
    if #folders >= 6 then
        uuid = folders[6].Name
        print("[AzraHub] Game folder detected: " .. uuid)
    else
        warn("[AzraHub] ERROR: UUID folder not found! Less than 6 folders.")
    end

    local Info = Window:NewTab("Info")
    local InfoSection = Info:NewSection("Information")
    InfoSection:NewButton("Copy Discord Link", "Join our discord server!", function()
        setclipboard("https://discord.gg/hnmJ3nsHS9")
    end)

    local Main = Window:NewTab("Main")
    local MainSection = Main:NewSection("Auto Clicker")

    local AutoClicker = false
    MainSection:NewToggle("Auto-Clicker [FAST]", "100 Clicks per second", function(state)
        AutoClicker = state
        if AutoClicker and uuid then
            task.spawn(function()
                while AutoClicker do
                    ReplicatedStorage[uuid].Events.Tap:FireServer(true, false)
                    task.wait(0.01)
                end
            end)
        end
    end)

    local rebirthOptions = {
        "+35t rebirths", "+15t rebirths", "+5t rebirths",  "+1t rebirths",  "+700b rebirths", "+350b rebirths", "+150b rebirths", "+50b rebirths",
        "+10b rebirths", "+7b rebirths",  "+3.5b rebirths", "+1.5b rebirths", "+500m rebirths", "+100m rebirths", "+70m rebirths", "+35m rebirths",
        "+15m rebirths", "+5m rebirths",  "+1m rebirths",  "+700k rebirths", "+350k rebirths", "+150k rebirths", "+50k rebirths", "+10k rebirths",
        "+7k rebirths",  "+3.5k rebirths", "+1.5k rebirths", "+500 rebirths", "+100 rebirths", "+70 rebirths", "+35 rebirths", "+15 rebirths",
        "+5 rebirths",   "+1 rebirth"
    }

    MainSection:NewLabel("Auto Rebirth")
    local selectedRebirthIndex = 1

    MainSection:NewDropdown(
        "Choose Rebirth!",
        "Choose your automatic rebirth amount here",
        rebirthOptions,
        function(selected)
            for index, name in ipairs(rebirthOptions) do
                if name == selected then
                    selectedRebirthIndex = 35 - index
                    break
                end
            end
        end
    )

    local AutoRebirth = false
    MainSection:NewToggle("Auto Rebirth", "Automatically rebirth based on selection", function(state)
        AutoRebirth = state
        if AutoRebirth and uuid then
            task.spawn(function()
                while AutoRebirth do
                    ReplicatedStorage[uuid].Functions.Rebirth:InvokeServer(selectedRebirthIndex)
                    task.wait(0.5)
                end
            end)
        end
    end)

    local eggOptions = {
        "Acorn", "Angelic", "Atlantis", "Basic", "Cactus", "Candy", "Elemental", "Forest", "Frozen", "Holy",
        "Magma", "Poison", "Safari", "Sakura", "Samurai", "Snowman", "Space", "Temple", "Tropical", "Volcanic"
    }

    local selectedEgg = "Basic"
    local selectedEggAmount = 1
    local AutoHatch = false

    MainSection:NewLabel("Auto Hatch")
    MainSection:NewDropdown(
        "Select Egg",
        "Select the egg you want to hatch",
        eggOptions,
        function(option)
            selectedEgg = option
        end
    )
    MainSection:NewDropdown(
        "Select Egg Amount",
        "Select the amount of hatching you want",
        {"1", "3", "8"},
        function(option)
            selectedEggAmount = tonumber(option)
        end
    )
    MainSection:NewToggle("Auto Hatch", "This will make you auto hatch", function(state)
        AutoHatch = state
        if AutoHatch and uuid then
            task.spawn(function()
                while AutoHatch do
                    ReplicatedStorage[uuid].Functions.OpenEgg:InvokeServer(selectedEgg, selectedEggAmount)
                    task.wait(0.5)
                end
            end)
        end
    end)

    local Customize = Window:NewTab("Customize")
    local CustomizeSection = Customize:NewSection("Color Custom")
    CustomizeSection:NewColorPicker("SchemeColor", "Change your SchemeColor", Color3.fromRGB(0, 255, 255), function(color)
        Library:ChangeColor("SchemeColor", color)
    end)

    -- Anti-AFK
    local GC = getconnections or get_signal_cons
    if GC then
        for i, v in pairs(GC(game.Players.LocalPlayer.Idled)) do
            if v["Disable"] then
                v["Disable"](v)
            elseif v["Disconnect"] then
                v["Disconnect"](v)
            end
        end
    else
        local vu = game:GetService("VirtualUser")
        game:GetService("Players").LocalPlayer.Idled:connect(function()
            vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            wait(1)
            vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        end)
    end

    warn("ANTI AFK!")
    warn("AZRA HUB HAS BEEN LOADED!")
end
