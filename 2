    MainSection:NewLabel("Example Label")

    -- NewSlider
    MainSection:NewSlider("Walkspeed", "Changes the Walkspeed", 250, 16, function(v)
        game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = v
    end)

    -- Example Tab: Customize
    local Customize = Window:NewTab("Customize")
    local CustomizeSection = Customize:NewSection("Color Custom")

