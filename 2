    local Window = Library.CreateLib("AZRA HUB", {
        SchemeColor = Color3.fromRGB(0, 255, 255),
        Background = Color3.fromRGB(0, 0, 0),
        Header = Color3.fromRGB(0, 0, 0),
        TextColor = Color3.fromRGB(255, 255, 255),
        ElementColor = Color3.fromRGB(20, 20, 20)
    })

    -- Example Tab: Main
    local Main = Window:NewTab("Main")
    local MainSection = Main:NewSection("Main")

    -- NewToggle
    MainSection:NewToggle("Auto-Clicker [FAST]", "100 Clicks per second", function(state)
        autoClick = state
    end)

    -- Auto Click Loop
    task.spawn(function()
    while true do
        if autoClick then
            tapRemote:FireServer(true, false)
        end
        task.wait(0.01)
    end
end)

    -- NewButton
    MainSection:NewButton("Example Button", "Description", function()
        print("Button clicked")
    end)

