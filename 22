-- SERVICES
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- 🔑 FUNCTION TO GET CURRENT SESSION FOLDER
local function getIDFolder()
    local folder = ReplicatedStorage:FindFirstChildWhichIsA("Folder")
    while not folder do
        task.wait(0.1)
        folder = ReplicatedStorage:FindFirstChildWhichIsA("Folder")
    end
    return folder
end

