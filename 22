-- AUTO REBIRTH
---------------------------
MainSection:NewLabel("Auto Rebirth")
local rebirthOptions = {
    "+35t","+15t","+5t","+1t","+700b","+350b","+150b","+50b",
    "+10b","+7b","+3.5b","+1.5b","+500m","+100m","+70m","+35m",
    "+15m","+5m","+1m","+700k","+350k","+150k","+50k",
    "+10k","+7k","+3.5k","+1.5k","+500","+100","+70","+35","+15","+5","+1"
}
local selectedRebirthIndex = 1
local AutoRebirth = false

MainSection:NewDropdown("Choose Rebirth!", "Highest ➜ Lowest", rebirthOptions, function(selected)
    for i, name in ipairs(rebirthOptions) do
        if name == selected then
            selectedRebirthIndex = 35 - i
            break
        end
    end
end)

MainSection:NewToggle("Auto Rebirth", "Automatically rebirth", function(state)
    AutoRebirth = state
    if AutoRebirth then
        task.spawn(function()
            local delayTime = 0.5
            while AutoRebirth do
                local folder = getIDFolder()
                if folder.Functions and folder.Functions:FindFirstChild("Rebirth") then
                    pcall(function()
                        folder.Functions.Rebirth:InvokeServer(selectedRebirthIndex)
                    end)
                end
                task.wait(delayTime)
            end
        end)
    end
end)

